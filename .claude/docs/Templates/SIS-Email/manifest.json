  "criticalFindings": [
    {
      "severity": "CRITICAL",
      "issue": "62 of 71 active email templates contain Fidelo single-brace {placeholders} that the SIS resolver does not touch. Recipients see literal text like {firstname}, {accommodation_provider_name}, {date_course_start} in the sent email.",
      "affected": 62,
      "mostCommonLeaks": [
        "{firstname} — 57 templates",
        "{surname} — 19",
        "{roomtype_full} — 19",
        "{date_accommodation_start} — 17",
        "{date_accommodation_end} — 17",
        "{accommodation_category} — 16",
        "{start_loop_accommodations}/{end_loop_accommodations} — 15/14 (Fidelo loop control)",
        "{accommodation_meal_full} — 12",
        "{booked_transfer}, {school_name}, {date_course_start} — 11 each"
      ],
      "fixOptions": [
        "A. Bulk-rewrite leaks to SIS double-brace equivalents (recommended). Build a token-rename map { firstname: \"student.first_name\", surname: \"student.last_name\", date_course_start: \"booking.start_date\", ... } and rewrite every htmlTemplate. ~half a day, one-shot.",
        "B. Extend the resolver to also process Fidelo single-brace placeholders. Lower-effort initial change but accepts Fidelo syntax as a permanent shape — opposite direction to the doc-template clean-up that already happened."
      ]
    },
    {
      "severity": "HIGH",
      "issue": "Day1-Orient (and similar) use Fidelo {if course_category == \"Morning Classes\"}…{/if} equality blocks. SIS renderTemplate only matches {if token} (truthy), so equality blocks fall through untouched → recipient sees ALL session variants stitched together WITH the {if …} / {/if} control tags visible.",
      "affected": [
        "Day1-Orient"
      ],
      "controlBlockTemplates": 24,
      "fixOptions": [
        "A. Rewrite Day-1 (and any sibling) to plain JS-rendered conditional: drop the {if x == \"y\"} syntax, use {{course_session_block}} that the resolver computes (returns the right snippet based on booking.courses[0].category). One value, one substitution.",
        "B. Extend renderTemplate to recognise the Fidelo equality form. Then every {if x == \"y\"} block in every template works. Slightly bigger blast radius but unblocks 24 templates at once."
      ]
    },
    {
      "severity": "HIGH",
      "issue": "FeedbackFinal and FeedbackFinal2-ExitLetter both have href=\"{link_feedback_12}\" — the Fidelo placeholder is never substituted, so the anchor href renders literally and the link goes nowhere when clicked.",
      "affected": [
        "FeedbackFinal",
        "FeedbackFinal2-ExitLetter"
      ],
      "fix": "Replace with the SIS feedback URL (e.g. https://sis.ulearnschool.com/feedback/{{student.id}} or whatever public feedback surface we are pointing at). The current {link_feedback_12} corresponds to a Fidelo deep-link the new system does not own."
    },
    {
      "severity": "MEDIUM",
      "issue": "Visa-Approval-Notice references {{booking.original_start_date}} — not produced by the resolver. Renders as empty string. Likely refers to Student.visaShuntOriginalArrival (the pre-shunt arrival date stamped during applyVisaApprovalShunt).",
      "affected": [
        "Visa-Approval-Notice"
      ],
      "fix": "Add booking.original_start_date to resolveTokens, sourcing from student.visaShuntOriginalArrival."
